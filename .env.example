# ---------------------------------------------------------------------------
# Auth & API
# ---------------------------------------------------------------------------
OMC_AUTH_SECRET=change-me-to-a-long-random-string
DEV_MODE=1                    # 1 = token returned in API response for testing
                              # 0 or unset = token delivered via email (production)

# ---------------------------------------------------------------------------
# Email delivery — provider selection
# ---------------------------------------------------------------------------
# MAILER_BACKEND=auto (or unset): auto-detect from SMTP_* / AWS_SES_* vars
# MAILER_BACKEND=console      : log to stdout (dev/testing)
# MAILER_BACKEND=smtp         : force SMTP (requires SMTP_HOST)
# MAILER_BACKEND=ses          : force AWS SES (requires AWS_SES_FROM)

# ---------------------------------------------------------------------------
# Email delivery — SMTP provider
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_TLS=1
SMTP_USERNAME=noreply@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=noreply@example.com

# ---------------------------------------------------------------------------
# Email delivery — AWS SES provider (takes priority over SMTP when set)
# ---------------------------------------------------------------------------
AWS_SES_FROM=noreply@example.com
AWS_SES_REGION=us-east-1
# Omit to use default credential chain (IAM role / ~/.aws/credentials)
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...

# ---------------------------------------------------------------------------
# API server
# ---------------------------------------------------------------------------
OMC_API_HOST=127.0.0.1
OMC_API_PORT=8787
OMC_API_RELOAD=0

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# OMC_DB_PATH=~/.hermes/omc/omc.db

# ---------------------------------------------------------------------------
# Legacy config (bridge.py only)
# ---------------------------------------------------------------------------
# OMC_CONFIG=config/omc.yaml
